# Create a Discord bot application, enable the applications.commands scope,
# and place its bot token here.
DISCORD_TOKEN=replace-with-bot-token

# The single Discord guild where slash commands should be registered.
DISCORD_GUILD_ID=123456789012345678

# Comma-separated Discord user IDs permitted to operate the host service.
ALLOWED_USER_IDS=123456789012345678

# Optional Compose service whose container uptime appears in the bot presence.
# Defaults to SERVICE_UNIT, or the only running container if unambiguous.
# TARGET_COMPOSE_SERVICE=facebed

# Optional Discord channel ID where new facebed systemd journal logs are sent.
LOG_CHANNEL_ID=123456789012345678

# Exact host file used by the facebed systemd unit's Compose project.
FACEBED_COMPOSE_FILE_HOST=/path/to/facebed/compose.yaml